{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": [
        "./src/renderer/src/*"
      ],
      "@assets/*": [
        "./src/renderer/assets/*"
      ],
      "@preload/*": [
        "./src/preload/*"
      ],
      "@components/*": [
        "./src/renderer/src/components/*"
      ],
      "@lib/*": [
        "./src/renderer/src/lib/*"
      ]
    }
  }
}
